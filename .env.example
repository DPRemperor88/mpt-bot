# Скопируйте этот файл в ".env" и заполните значения.

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# ID главных администраторов через запятую
ADMIN_IDS=123456789,987654321

# (необязательно) URL базы данных; по умолчанию SQLite bot.db в корне проекта
# DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Адрес сервера для deploy.ps1 (чтобы не хранить IP в репозитории)
SERVER_HOST=root@IP
